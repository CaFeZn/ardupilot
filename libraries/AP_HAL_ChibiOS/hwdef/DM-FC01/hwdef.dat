# hw definition file for processing by chibios_hwdef.py
# for the DM-FC01 hardware (based on NxtPX4v2 but with modifications)
#
# Primary differences:
#  - red LED moved to PE12 instead of PD15
#  - SBUS inverter moved to PE15 instead of PD14
#  - two IMU heater outputs on PD14/PD15
#  - heater support enabled


# MCU class and specific type
MCU STM32H7xx STM32H743xx

# board ID. See Tools/AP_Bootloader/board_types.txt
APJ_BOARD_ID AP_HW_DM_FC01

# crystal frequency
OSCILLATOR_HZ 16000000

# ChibiOS system timer
STM32_ST_USE_TIMER 12
define CH_CFG_ST_RESOLUTION 16

# flash size
FLASH_SIZE_KB 2048
FLASH_RESERVE_START_KB 128

define HAL_STORAGE_SIZE 32768

# default to all pins low to avoid ESD issues
DEFAULTGPIO OUTPUT LOW PULLDOWN

# order of UARTs (and USB)
# SERIAL0:OTG1 SERIAL1:USART2 SERIAL2:UART8 SERIAL3:USART1 SERIAL4:USART3
# SERIAL5:UART5 SERIAL6:UART7 SERIAL7:UART4 SERIAL8:USART6
SERIAL_ORDER  OTG1 USART2 UART8 USART1 USART3 UART5 UART7 UART4 USART6

# USB
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1
PA15 VBUS INPUT OPENDRAIN   # DM-FC01 uses PA15 for VBUS detect

# CAN1 is available on the FMU connector using the same pins that PX4
# refers to as GPIO_CAN1_RX_3 / GPIO_CAN1_TX_3 (PD0/PD1).
PD0  CAN1_RX  CAN1
PD1  CAN1_TX  CAN1


# GPS1
PA9  USART1_TX USART1
PA10 USART1_RX USART1

# TELEM1
PD6 USART2_RX USART2
PD5 USART2_TX USART2

# DJI O3
PD8 USART3_TX USART3
PD9 USART3_RX USART3

# TELEM2
PE1 UART8_TX UART8
PE0 UART8_RX UART8

# RC_INPUT
PB13 UART5_TX UART5
PB12 UART5_RX UART5
# SBUS inverter placed on PE15 on DM‑FC01
PE15 SBUS_INV OUTPUT LOW

# ESC
PE7 UART7_RX UART7

# TELEM3
PB9 UART4_TX UART4
PB8 UART4_RX UART4

# TELEM4
PC6 USART6_TX USART6
PC7 USART6_RX USART6

# SWD
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

# two I2C bus
I2C_ORDER I2C1 I2C4

# I2C1 - baro
PB6 I2C1_SCL I2C1
PB7 I2C1_SDA I2C1

# I2C4 - CONNECTOR
PD12 I2C4_SCL I2C4
PD13 I2C4_SDA I2C4

# PWM output pins
PE9  TIM1_CH1 TIM1  PWM(1) GPIO(50)
PE11 TIM1_CH2 TIM1  PWM(2) GPIO(51)
PE13 TIM1_CH3 TIM1  PWM(3) GPIO(52)
PE14 TIM1_CH4 TIM1  PWM(4) GPIO(53)
PB10 TIM2_CH3 TIM2  PWM(6) GPIO(54)
PB11 TIM2_CH4 TIM2  PWM(5) GPIO(55)
PB0  TIM3_CH3 TIM3  PWM(7) GPIO(56)
PB1  TIM3_CH4 TIM3  PWM(8) GPIO(57)

# GPIOs
PA4 PINIO1 OUTPUT GPIO(81) LOW
PC1 PINIO2 OUTPUT GPIO(82) LOW
PC0 AUX1_PC0 INPUT GPIO(83)
PB2 SPI3_MOSI SPI3 GPIO(84)
PB4 SPI3_MISO SPI3 GPIO(85)
PB3 SPI3_SCK  SPI3 GPIO(86)

# heater outputs (one per IMU).  Each heater is controlled independently
# so the two sensor boards can be heated separately.  PD14 drives the
# BMI088 housing while PD15 powers the ICM45686 on the companion board.
PD14 HEATER_EN  OUTPUT LOW GPIO(93)
PD15 HEATER2_EN OUTPUT LOW GPIO(94)

# LEDs
PE12 LED_RED   OUTPUT HIGH GPIO(90)
PD11 LED_GREEN OUTPUT HIGH GPIO(91)
PB15 LED_BLUE  OUTPUT HIGH GPIO(92)

define AP_NOTIFY_GPIO_LED_RGB_RED_PIN 90
define AP_NOTIFY_GPIO_LED_RGB_GREEN_PIN 91
define AP_NOTIFY_GPIO_LED_RGB_BLUE_PIN 92

define HAL_GPIO_LED_ON 1
define AP_NOTIFY_GPIO_LED_RGB_ENABLED 1

# ADC for Power
PC4 BATT_VOLTAGE_SENS ADC1 SCALE(1)
PC5 BATT_CURRENT_SENS ADC2 SCALE(1)

define HAL_BATT_VOLT_PIN 4
define HAL_BATT_CURR_PIN 8
define HAL_BATT_VOLT_SCALE 10.2
define HAL_BATT_CURR_SCALE 20.4

# no built-in compass, but probe the i2c bus for all possible
# external compass types
define ALLOW_ARM_NO_COMPASS
define AP_COMPASS_PROBING_ENABLED 1

# microSD support
PC12 SDMMC1_CK  SDMMC1
PD2  SDMMC1_CMD SDMMC1
PC8  SDMMC1_D0  SDMMC1
PC9  SDMMC1_D1  SDMMC1
PC10 SDMMC1_D2  SDMMC1
PC11 SDMMC1_D3  SDMMC1
define FATFS_HAL_DEVICE SDCD1

# SPI1 - IMU0
PA5 SPI1_SCK SPI1
PA6 SPI1_MISO SPI1
PA7 SPI1_MOSI SPI1
PA3 BMI088_1_G_CS CS
PA2 BMI088_1_A_CS CS

# SPI2 - external flash (Winbond W25Q128JVSQ 16MB)
# pins were provided by the user:
#   MISO = PB14, SCK = PD3, MOSI = PC3, CS = PD4
PB14 SPI2_MISO SPI2
PD3  SPI2_SCK  SPI2
PC3  SPI2_MOSI SPI2
PD4  FLASH_CS  CS

# SPI4 - IMU1
PE6 SPI4_MOSI SPI4
PE2 SPI4_SCK  SPI4
PE5 SPI4_MISO SPI4
PC2 ICM45686_G_CS CS
PC13 ICM45686_A_CS CS

# barometers
BARO SPL06 I2C:0:0x77

# enable onboard W25Q128 dataflash logging support while keeping SD
# filesystem logging as the default backend.
define HAL_LOGGING_DATAFLASH_ENABLED 1
define HAL_LOGGING_DATAFLASH_DRIVER AP_Logger_Flash_JEDEC
define HAL_LOGGING_BACKENDS_DEFAULT Backend_Type::FILESYSTEM

# SPI devices
SPIDEV imu0_a      SPI1 DEVID1  BMI088_1_A_CS    MODE3  10*MHZ 10*MHZ
SPIDEV imu0_g      SPI1 DEVID2  BMI088_1_G_CS    MODE3  10*MHZ 10*MHZ
SPIDEV dataflash   SPI2 DEVID1  FLASH_CS         MODE0  50*MHZ 50*MHZ
SPIDEV imu1_a      SPI4 DEVID3  ICM45686_A_CS    MODE3  10*MHZ 10*MHZ

# 2 IMUs
IMU BMI088       SPI:imu0_a SPI:imu0_g ROTATION_PITCH_180
IMU Invensensev3 SPI:imu1_a            ROTATION_PITCH_180  # ICM45686, use accel CS as main (or gyro, but accel common)

# enable FAT filesystem support (needs a microSD defined via SDMMC)
define HAL_OS_FATFS_IO 1

# heater configuration ----------------------------------------------------
# heater #1 drives IMU instance 0 (BMI088)
define HAL_HAVE_IMU_HEATER 1
define AP_HEATER_IMU_INSTANCE 0
define HAL_HEATER_GPIO_PIN  93                # PD14
# heater #2 drives IMU instance 1 (ICM45686)
define HAL_HAVE_IMU_HEATER2 1
define AP_HEATER2_IMU_INSTANCE 1
define HAL_HEATER2_GPIO_PIN 94                # PD15
# default target temperatures and PI controller tuning
# (can be overridden via HEAT_TARG, HEAT_TARG2 etc.)
define HAL_IMU_TEMP_DEFAULT 45
define HAL_IMUHEAT_P_DEFAULT 50
define HAL_IMUHEAT_I_DEFAULT 0.07
#define HAL_IMU_TEMP2_DEFAULT 45
#define HAL_IMUHEAT2_P_DEFAULT 50
#define HAL_IMUHEAT2_I_DEFAULT 0.07
