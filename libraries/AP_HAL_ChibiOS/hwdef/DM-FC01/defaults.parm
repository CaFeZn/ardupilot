#BATTERY MONITOR ON
BATT_MONITOR 4

# Board mounting orientation
# 0 = ROTATION_NONE
AHRS_ORIENTATION 0

#Serial Port defaults
# SERIAL1 UART2 TELEM1
SERIAL1_PROTOCOL = 2
SERIAL1_BAUD = 115

# SERIAL2 UART8 TELEM2
SERIAL2_PROTOCOL = 2
SERIAL2_BAUD = 57

# SERIAL3 UART1 GPS
SERIAL3_PROTOCOL = 5
SERIAL3_BAUD = 0

# SERIAL4 UART3 DJI O3 MSP
SERIAL4_PROTOCOL = 32
SERIAL4_BAUD = 115

# SERIAL5 UART5 RCIN ELRS
SERIAL5_PROTOCOL = 23
SERIAL5_BAUD = 420
RC_PROTOCOLS = 1

# SERIAL6 UART7 ESC Telemetry
SERIAL6_PROTOCOL = 16
SERIAL6_BAUD = 57

# SERIAL7 UART4
SERIAL7_PROTOCOL = -1
SERIAL7_BAUD = 57

# SERIAL8 UART6
SERIAL8_PROTOCOL = -1
SERIAL8_BAUD = 57

#MSP DisplayPort enable
OSD_TYPE 5

# IMU heater temperature defaults (primary and secondary)
BRD_HEAT_TARG 45
BRD_HEAT_TARG2 45
